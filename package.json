{
  "name": "japread",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --debug --no-bundle",
    "format": "prettier --write src vite.config.ts && cargo fmt --all",
    "server": "cargo run -p japread-local-server",
    "test": "cargo test -p japread-core -p japread-sources"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "vite": "^6.1",
    "vue-tsc": "^2.2"
  }
}
